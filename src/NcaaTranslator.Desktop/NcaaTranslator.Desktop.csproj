<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <VersionPrefix>4.0.0</VersionPrefix>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UiDir>$(MSBuildThisFileDirectory)../../ui</UiDir>
    <!-- Keep sln/test builds off the Vite pipeline. Opt in with -p:SkipUiBuild=false -->
    <SkipUiBuild Condition="'$(SkipUiBuild)' == ''">true</SkipUiBuild>
    <!-- Photino.NET.Server ManifestEmbeddedFileProvider requires a manifest. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NcaaTranslator.Library\NcaaTranslator.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.11" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="Photino.NET.Server" Version="4.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- PreserveNewest so rebuilds do not clobber user Settings.json / NcaaNameConverter.json in bin/ -->
    <Content Include="..\..\config\Settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\config\NcaaNameConverter.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Resources\**" />
  </ItemGroup>

  <ItemGroup>
    <UiSource Include="$(UiDir)/package.json" />
    <UiSource Include="$(UiDir)/package-lock.json" />
    <UiSource Include="$(UiDir)/vite.config.ts" />
    <UiSource Include="$(UiDir)/tsconfig.json" />
    <UiSource Include="$(UiDir)/index.html" />
    <UiSource Include="$(UiDir)/src/**/*.*" />
  </ItemGroup>

  <!-- Opt-in Vite rebuild. Default SkipUiBuild=true uses committed wwwroot. -->
  <Target Name="BuildUi"
          BeforeTargets="BeforeBuild"
          Condition="'$(SkipUiBuild)' != 'true'"
          Inputs="@(UiSource)"
          Outputs="$(UiDir)/dist/index.html">
    <Exec Command="node -v" IgnoreExitCode="true" StandardOutputImportance="Low" StandardErrorImportance="Low">
      <Output TaskParameter="ExitCode" PropertyName="_NodeExitCode" />
    </Exec>
    <PropertyGroup>
      <_HasNode Condition="'$(_NodeExitCode)' == '0'">true</_HasNode>
    </PropertyGroup>
    <Message Importance="high" Text="Node.js not found; using prebuilt wwwroot." Condition="'$(_HasNode)' != 'true'" />
    <Exec Command="npm ci" WorkingDirectory="$(UiDir)" Condition="'$(_HasNode)' == 'true' AND !Exists('$(UiDir)/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(UiDir)" Condition="'$(_HasNode)' == 'true'" />
  </Target>

  <!-- VS Code F5 launches this copy so macOS Dock/menu bar show "NCAA Translator"
       instead of "dotnet" (dll) or "NcaaTranslator.Desktop" (apphost). -->
  <Target Name="CopyMacAppHostDisplayName"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PropertyGroup>
      <_AppHostPath>$(OutputPath)$(AssemblyName)</_AppHostPath>
      <_DisplayHostPath>$(OutputPath)NCAA Translator</_DisplayHostPath>
    </PropertyGroup>
    <Copy SourceFiles="$(_AppHostPath)"
          DestinationFiles="$(_DisplayHostPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_AppHostPath)')" />
  </Target>

  <Target Name="CopyUiDistToOutput"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(SkipUiBuild)' != 'true' AND Exists('$(UiDir)/dist/index.html')">
    <ItemGroup>
      <_UiDist Include="$(UiDir)/dist/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_UiDist)"
          DestinationFiles="@(_UiDist->'$(OutputPath)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
